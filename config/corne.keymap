/*
 * Corne 36-key (5-column) — ported from a Miryoku layout for ZMK Studio.
 *
 * Split of labor:
 *   - Move plain keys around LIVE in ZMK Studio (the &kp positions).
 *   - Tune the mod-tap / layer-tap timings HERE in this file (see behaviors block).
 *
 * NOTE: once you start managing the keymap in Studio, edits to this file won't
 * apply until you use "Restore Stock Settings" in Studio. Adding new empty
 * "reserved" layers is the sanctioned exception.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

// Layer indices — used by &mo / &ltp / &to below. Studio shows the display-names.
#define BASE  0
#define BTN   1
#define NAV   2
#define MOUSE 3
#define MEDIA 4
#define NUM   5
#define SYM   6
#define FUN   7

/ {
    chosen {
        // Default to the 36-key / 5-column physical layout (your board).
        // The 6-column layout is still compiled in and selectable from Studio.
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    behaviors {
        /*
         * Bottom-row mod-tap: hold = modifier, tap = key.
         * Miryoku baseline reproduced exactly: tap-preferred, 200 ms.
         * This is your "deep control" surface — tune it here:
         *   flavor: "tap-preferred" | "balanced" | "hold-preferred"
         *   tapping-term-ms: lower = mods trigger sooner
         *   quick-tap-ms: tap-then-hold within N ms repeats the TAP (good for
         *                 holding a letter to repeat it)
         *   require-prior-idle-ms: suppress the hold if you were just typing
         *                          (biggest single win against HRM misfires)
         */
        hm: bottom_row_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            // quick-tap-ms = <175>;
            // require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        /*
         * Layer-tap: hold = momentary layer, tap = key. Same Miryoku baseline.
         * Tune independently from the mods above.
         */
        ltp: layer_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            // quick-tap-ms = <175>;
            // require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
   &kp Q         &kp W         &kp E          &kp R          &kp T             &kp Y            &kp U          &kp I             &kp O           &kp P
   &kp A         &kp S         &kp D          &kp F          &kp G             &kp H            &kp J          &kp K             &kp L           &kp SEMI
   &ltp BTN Z     &hm LALT X    &hm LCTRL C    &hm LSHFT V    &hm LGUI B        &hm LGUI N       &hm LSHFT M    &hm LCTRL COMMA   &hm LALT DOT    &ltp BTN SLASH
                               &ltp MEDIA ESC  &ltp NAV TAB    &ltp MOUSE SPACE   &ltp SYM BSPC     &ltp NUM RET    &ltp FUN DEL
            >;
        };

        button_layer {
            display-name = "Button";
            bindings = <
   &kp LC(Z)     &kp LC(X)     &kp LC(C)      &kp LC(V)      &kp LC(Y)         &kp LC(Y)        &kp LC(V)      &kp LC(C)         &kp LC(X)       &kp LC(Z)
   &kp LGUI      &kp LALT      &kp LCTRL      &kp LSHFT      &none             &none            &kp LSHFT      &kp LCTRL         &kp LALT        &kp LGUI
   &kp LC(Z)     &kp LC(X)     &kp LC(C)      &kp LC(V)      &kp LC(Y)         &kp LC(Y)        &kp LC(V)      &kp LC(C)         &kp LC(X)       &kp LC(Z)
                               &mkp MCLK      &mkp LCLK      &mkp RCLK         &mkp RCLK        &mkp LCLK      &mkp MCLK
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
   &bootloader   &none         &none          &to BASE       &none             &kp INS          &kp HOME       &kp UP            &kp END         &kp PG_UP
   &kp LC(Z)     &kp LC(X)     &kp LC(C)      &kp LC(V)      &kp LC(Y)         &caps_word       &kp LEFT       &kp DOWN          &kp RIGHT       &kp PG_DN
   &kp LALT      &kp RALT      &kp LCTRL      &kp LSHFT      &kp LGUI          &kp LC(Z)        &kp LC(X)      &kp LC(C)         &kp LC(V)       &kp LC(Y)
                               &none          &none          &none             &kp RET          &kp BSPC       &kp DEL
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
   &bootloader   &none         &none          &to BASE       &none             &kp LC(Y)        &kp LC(V)      &kp LC(C)         &kp LC(X)       &kp LC(Z)
   &kp LGUI      &kp LALT      &kp LCTRL      &kp LSHFT      &none             &none            &mmv MOVE_LEFT &mmv MOVE_DOWN    &mmv MOVE_UP    &mmv MOVE_RIGHT
   &none         &kp RALT      &to SYM        &to MOUSE      &none             &none            &msc SCRL_LEFT &msc SCRL_DOWN    &msc SCRL_UP    &msc SCRL_RIGHT
                               &none          &none          &none             &mkp RCLK        &mkp LCLK      &mkp MCLK
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
   &bootloader   &none         &none          &to BASE       &studio_unlock    &none            &none          &none             &none           &none
   &kp LGUI      &kp LALT      &kp LCTRL      &kp LSHFT      &none             &ext_power EP_TOG &kp C_PREV     &kp C_VOL_DN      &kp C_VOL_UP    &kp C_NEXT
   &none         &kp RALT      &to FUN        &to MEDIA      &none             &out OUT_TOG     &bt BT_SEL 0   &bt BT_SEL 1      &bt BT_SEL 2    &bt BT_SEL 3
                               &none          &none          &none             &kp C_STOP       &kp C_PP       &kp C_MUTE
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
   &kp LBKT      &kp N7        &kp N8         &kp N9         &kp RBKT          &none            &to BASE       &none             &none           &bootloader
   &kp SEMI      &kp N4        &kp N5         &kp N6         &kp EQUAL         &none            &kp LSHFT      &kp LCTRL         &kp LALT        &kp LGUI
   &kp GRAVE     &kp N1        &kp N2         &kp N3         &kp BSLH          &none            &to NUM        &to NAV           &kp RALT        &none
                               &kp DOT        &kp N0         &kp MINUS         &none            &none          &none
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
   &kp SQT       &kp DQT       &kp CARET      &kp BSLH       &kp GRAVE         &kp LBKT         &kp LT         &kp EQUAL         &kp GT          &kp RBKT
   &kp EXCL      &kp AT        &kp HASH       &kp DLLR       &kp AMPS          &kp LBRC         &kp LPAR       &kp PIPE          &kp RPAR        &kp RBRC
   &kp PRCNT     &kp SLASH     &kp MINUS      &kp PLUS       &kp ASTRK         &kp UNDER        &none          &none             &none           &none
                               &none          &none          &none             &none            &none          &none
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
   &kp F12       &kp F7        &kp F8         &kp F9         &kp PSCRN         &none            &to BASE       &none             &none           &bootloader
   &kp F11       &kp F4        &kp F5         &kp F6         &kp SLCK          &none            &kp LSHFT      &kp LCTRL         &kp LALT        &kp LGUI
   &kp F10       &kp F1        &kp F2         &kp F3         &kp PAUSE_BREAK   &none            &to FUN        &to MEDIA         &kp RALT        &none
                               &kp K_APP      &kp SPACE      &kp TAB           &none            &none          &none
            >;
        };

        // Empty layers reserved for you to fill in live from ZMK Studio.
        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
    };
};
